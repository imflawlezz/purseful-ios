    "You will be prompted to match accounts and categories before importing.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will be prompted to match accounts and categories before importing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed importem dopasujesz konta i kategorie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед импортом нужно будет сопоставить счета и категории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед імпортом потрібно буде зіставити рахунки й категорії."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Import wirst du Konten und Kategorien zuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de importar, deberás asociar cuentas y categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant l’import, vous associerez les comptes et catégories."
          }
        }
      }
    },
    "Your account balances. The larger size also shows today’s spend and what’s coming up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kontosalden. Die größere Größe zeigt auch heutige Ausgaben und anstehende Zahlungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account balances. The larger size also shows today’s spend and what’s coming up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos de tus cuentas. El tamaño grande también muestra el gasto de hoy y lo que viene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes de vos comptes. La grande taille montre aussi les dépenses du jour et ce qui arrive."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salda kont. Większy rozmiar pokazuje też dzisiejsze wydatki i to, co nadchodzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансы счетов. В большем размере также видны траты за сегодня и ближайшие платежи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланси рахунків. У більшому розмірі також видно витрати за сьогодні й найближчі платежі."
          }
        }
      }
    },
