    "For each account in the backup, pick which of yours it should become.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle für jedes Konto im Backup, welches deiner Konten es werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For each account in the backup, pick which of yours it should become."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cada cuenta de la copia, elige en cuál de las tuyas debe convertirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour chaque compte de la sauvegarde, choisissez lequel des vôtres il doit devenir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla każdego konta z kopii wybierz, którym z Twoich ma się stać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для каждого счёта из копии выберите, каким из ваших он станет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кожного рахунку з копії виберіть, яким із ваших він стане."
          }
        }
      }
    },
