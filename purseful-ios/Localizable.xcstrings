    "Restore a backup from legacy Purseful website.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore a backup from legacy Purseful website."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć kopię ze starej strony Purseful."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите резервную копию со старого сайта Purseful."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновіть резервну копію зі старого сайту Purseful."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle ein Backup der früheren Purseful-Website wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura una copia del sitio anterior de Purseful."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez une sauvegarde de l’ancien site Purseful."
          }
        }
      }
    },
    "Restore a Purseful backup—accounts, transactions, budgets, goals, and more. Merge keeps your current settings; otherwise the file’s settings are used.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle ein Purseful-Backup wieder her — Konten, Buchungen, Budgets, Ziele und mehr. Zusammenführen behält deine Einstellungen; sonst gelten die der Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore a Purseful backup—accounts, transactions, budgets, goals, and more. Merge keeps your current settings; otherwise the file’s settings are used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura una copia de Purseful: cuentas, movimientos, presupuestos, metas y más. Fusionar conserva tus ajustes; si no, se usan los del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez une sauvegarde Purseful — comptes, opérations, budgets, objectifs et plus. La fusion conserve vos réglages ; sinon ceux du fichier sont utilisés."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć kopię Purseful — konta, transakcje, budżety, cele i więcej. Scalanie zachowa Twoje ustawienia; w przeciwnym razie użyte zostaną te z pliku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите копию Purseful — счета, операции, бюджеты, цели и другое. Объединение сохранит ваши настройки; иначе будут взяты настройки из файла."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновіть копію Purseful — рахунки, операції, бюджети, цілі та інше. Об’єднання збереже ваші налаштування; інакше буде взято налаштування з файлу."
          }
        }
      }
    },
