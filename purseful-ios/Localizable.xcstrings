    "Match each category from the backup to one of yours. Only the same type is shown—income or expense.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne jede Kategorie aus dem Backup einer deiner Kategorien zu. Nur derselbe Typ wird angezeigt — Einnahme oder Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match each category from the backup to one of yours. Only the same type is shown—income or expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna cada categoría de la copia a una de las tuyas. Solo se muestra el mismo tipo: ingreso o gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez chaque catégorie de la sauvegarde à l’une des vôtres. Seul le même type s’affiche — revenu ou dépense."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasuj każdą kategorię z kopii do jednej ze swoich. Pokazywany jest tylko ten sam typ — przychód lub wydatek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сопоставьте каждую категорию из копии с одной из ваших. Показан только тот же тип — доход или расход."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зіставте кожну категорію з копії з однією зі своїх. Показано лише той самий тип — дохід або витрата."
          }
        }
      }
    },
