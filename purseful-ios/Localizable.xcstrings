    "Totals and reports convert into this currency. Rates come from Frankfurter and refresh when the app opens or you change base currency.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Totals and reports convert into this currency. Rates come from Frankfurter and refresh when the app opens or when you change base currency."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumy i raporty są przeliczane na tę walutę. Kursy pochodzą z Frankfurter i odświeżają się po otwarciu aplikacji lub zmianie waluty bazowej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги и отчёты пересчитываются в эту валюту. Курсы берутся из Frankfurter и обновляются при открытии приложения или смене базовой валюты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумки й звіти перераховуються в цю валюту. Курси з Frankfurter оновлюються під час відкриття застосунку або зміни базової валюти."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summen und Berichte werden in diese Währung umgerechnet. Kurse kommen von Frankfurter und aktualisieren sich beim App-Start oder bei geänderter Basiswährung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales y informes se convierten a esta moneda. Los tipos provienen de Frankfurter y se actualizan al abrir la app o al cambiar la moneda base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux et rapports sont convertis dans cette devise. Les taux viennent de Frankfurter et se mettent à jour à l’ouverture de l’app ou si vous changez la devise de base."
          }
        }
      }
    }
  },
  "version": "1.1"
}
