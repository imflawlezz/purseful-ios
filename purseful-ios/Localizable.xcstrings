    "Double-check the amount — scans aren’t always perfect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betrag prüfen — Scans sind nicht immer perfekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-check the amount — scans aren’t always perfect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el importe: el escaneo no siempre es perfecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le montant — les scans ne sont pas toujours parfaits."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź kwotę — skanowanie nie zawsze jest idealne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте сумму — сканирование бывает неточным."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте суму — сканування буває неточним."
          }
        }
      }
    },
