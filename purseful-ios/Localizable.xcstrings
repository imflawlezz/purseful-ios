    "This deletes everything — accounts, transactions, budgets, goals, payments, debts, the shopping list, and more. Default categories come back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alles — Konten, Buchungen, Budgets, Ziele, Zahlungen, Schulden, Einkaufsliste und mehr. Standardkategorien kommen zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes everything — accounts, transactions, budgets, goals, payments, debts, the shopping list, and more. Default categories come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra todo: cuentas, movimientos, presupuestos, metas, pagos, deudas, la lista de la compra y más. Las categorías predeterminadas vuelven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface tout — comptes, opérations, budgets, objectifs, paiements, dettes, liste de courses et plus. Les catégories par défaut reviennent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usuwa wszystko — konta, transakcje, budżety, cele, płatności, długi, listę zakupów i więcej. Domyślne kategorie wrócą."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалит всё — счета, операции, бюджеты, цели, платежи, долги, список покупок и другое. Стандартные категории вернутся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалить усе — рахунки, операції, бюджети, цілі, платежі, борги, список покупок та інше. Стандартні категорії повернуться."
          }
        }
      }
    },
    "This isn’t a Purseful export. For old website backups, use Import Backup (Legacy).": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn’t a Purseful export. For old website backups, use Import Backup (Legacy)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest eksport Purseful. Dla kopii ze starej strony użyj Importuj kopię (starsza wersja)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не экспорт Purseful. Для старых веб-резервных копий используйте «Импорт резервной копии (устаревший)»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не експорт Purseful. Для старих веб-резервних копій використайте «Імпорт резервної копії (застарілий)»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Purseful-Export. Für alte Website-Backups nutze „Backup importieren (Legacy)“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es una exportación de Purseful. Para copias del sitio anterior, usa Importar copia (anterior)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un export Purseful. Pour les anciennes sauvegardes web, utilisez Importer la sauvegarde (ancienne)."
          }
        }
      }
    },
