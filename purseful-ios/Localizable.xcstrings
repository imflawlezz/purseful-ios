    "Duplicates are skipped when merging. Turn this off to start clean.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zusammenführen werden Duplikate übersprungen. Ausschalten für einen Neustart."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicates are skipped when merging. Turn this off to start clean."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al fusionar se omiten los duplicados. Desactívalo para empezar de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de la fusion, les doublons sont ignorés. Désactivez pour repartir de zéro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy scalaniu duplikaty są pomijane. Wyłącz to, aby zacząć od zera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При объединении дубликаты пропускаются. Выключите, чтобы начать с чистого листа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час об’єднання дублікати пропускаються. Вимкніть, щоб почати з чистого аркуша."
          }
        }
      }
    },
