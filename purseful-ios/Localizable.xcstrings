    "Import a backup from the old Purseful website. Match each account and category to yours, or create new ones. Balances come from the file.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere ein Backup von der alten Purseful-Website. Ordne jedes Konto und jede Kategorie zu oder erstelle neue. Salden kommen aus der Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a backup from the old Purseful website. Match each account and category to yours, or create new ones. Balances come from the file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa una copia del antiguo sitio de Purseful. Asigna cada cuenta y categoría a las tuyas, o crea nuevas. Los saldos vienen del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez une sauvegarde de l’ancien site Purseful. Associez chaque compte et catégorie aux vôtres, ou créez-en de nouveaux. Les soldes viennent du fichier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportuj kopię ze starej strony Purseful. Dopasuj każde konto i kategorię do swoich albo utwórz nowe. Salda pochodzą z pliku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт копии со старого сайта Purseful. Сопоставьте каждый счёт и категорию со своими или создайте новые. Балансы берутся из файла."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпорт копії зі старого сайту Purseful. Зіставте кожен рахунок і категорію зі своїми або створіть нові. Баланси беруться з файлу."
          }
        }
      }
    },
