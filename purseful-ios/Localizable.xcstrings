    "Rent, salary, subscriptions — whatever repeats.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miete, Gehalt, Abos — alles, was sich wiederholt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent, salary, subscriptions — whatever repeats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alquiler, sueldo, suscripciones: lo que se repite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loyer, salaire, abonnements — tout ce qui se répète."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czynsz, pensja, subskrypcje — wszystko, co się powtarza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аренда, зарплата, подписки — всё, что повторяется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оренда, зарплата, підписки — усе, що повторюється."
          }
        }
      }
    },
